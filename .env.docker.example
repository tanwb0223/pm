# ============================================================================
# Docker 部署环境变量
# 复制为 .env.docker 后修改：cp .env.docker.example .env.docker
# ============================================================================

# ---------------------------------------------------------------- 必改（不填无法启动）
# 数据库密码
DB_PASSWORD=改成强密码

# 应用密钥：用于 JWT 签名与认证密钥加密
# 生成方式：python -c "import secrets; print(secrets.token_urlsafe(48))"
PM_SECRET_KEY=粘贴生成的随机串

# ---------------------------------------------------------------- 数据库
DB_USER=pm_app
DB_NAME=pm_prod

# ---------------------------------------------------------------- 应用
PM_APP_NAME=产教融合项目管理系统
PM_DEBUG=false
PM_ACCESS_TOKEN_EXPIRE_MINUTES=30
# 对外端口（8000 被占用时改成 8080）
HTTP_PORT=8000

# 跨域：前后端同域经 nginx 代理时无需改
# PM_CORS_ORIGINS=["https://pm.school.edu.cn"]

# ---------------------------------------------------------------- 附件
PM_UPLOAD_MAX_SIZE_MB=50

# ---------------------------------------------------------------- 定时任务
PM_SCHEDULER_ENABLED=true
PM_DAILY_SCAN_HOUR=1
PM_DIGEST_HOUR=8
PM_DIGEST_MINUTE=30

# ---------------------------------------------------------------- 邮件（预警通知）
PM_SMTP_HOST=
PM_SMTP_PORT=465
PM_SMTP_USER=
PM_SMTP_PASSWORD=
PM_SMTP_USE_SSL=true
PM_MAIL_FROM=

# ---------------------------------------------------------------- 前端托管
# 镜像内已内置前端产物，由 FastAPI 直接托管（无需 nginx）
# 如需改回 nginx 托管，设 PM_FRONTEND_SERVE=false
PM_FRONTEND_SERVE=true

# ---------------------------------------------------------------- 数据库自动备份
# 镜像内置 backup.sh，应用启动后自动注册定时任务，无需手工配置
PM_BACKUP_ENABLED=true
# 备份时间（默认凌晨 2:00，避开 1:00 的快照与预警扫描）
PM_BACKUP_HOUR=2
PM_BACKUP_MINUTE=0
# 保留天数
PM_BACKUP_KEEP_DAYS=30
