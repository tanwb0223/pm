# ============================================================================
# 产教融合项目管理系统 · Docker 部署配置
#
# 用法：
#   cp .env.docker.example .env
#   vi .env
#   sudo bash deploy.sh
#
# 注意：
#   - 一行一个 KEY=VALUE，等号两边不要空格；
#   - 值后面不要写行尾注释（需要注释请单独一行）；
#   - 路径可以是相对路径（相对于本目录）或绝对路径。
# ============================================================================

# ---------------------------------------------------------------- 项目 / 镜像
# 同一台机器部署多套时改这里，避免容器名冲突
PM_PROJECT_NAME=pm
# 离线包 docker load 后的镜像名；一般不用改
PM_IMAGE=pm-app:latest
PM_CADDY_IMAGE=caddy:2-alpine

# ---------------------------------------------------------------- 域名与证书
# 访问域名（auto / file / internal 模式必填；off 模式可留空用服务器 IP）
PM_DOMAIN=pm.example.edu.cn

# TLS 模式：
#   auto     公网域名 + Caddy 自动申请/续期 Let's Encrypt（需 80/443 可从公网访问）
#   file     使用 certs/ 下的自有证书（内网/学校统一证书，最常用）
#   internal Caddy 自签内部 CA（浏览器会提示不受信任，适合测试/内网过渡）
#   off      不启用 TLS，由前置网关终止 HTTPS（只映射 HTTP 端口）
PM_TLS_MODE=file

# file 模式：证书文件名（放在 docker/certs/ 下，PEM 格式；crt 需包含中间证书）
PM_TLS_CERT_NAME=server.crt
PM_TLS_KEY_NAME=server.key

# auto 模式：申请证书的邮箱（可选）
PM_ACME_EMAIL=

# 对外端口（TLS 模式建议保持 80/443）
PM_HTTP_PORT=80
PM_HTTPS_PORT=443

# 对外访问地址。留空 = deploy.sh 按域名/端口自动生成。
# 前置网关终止 HTTPS（off 模式）时，这里要写实际 https 地址，例如：
# PM_PUBLIC_URL=https://pm.school.edu.cn
PM_PUBLIC_URL=

# ---------------------------------------------------------------- 数据与附件
# SQLite 数据根目录：pm.db、backup、log、locks 都在这里。
# 生产建议用绝对路径，例如 /data/pm；升级/重装容器都不会删这里。
PM_DATA_DIR=./data

# 上传附件目录：可以单独挂到另一块盘或 NAS。
# 留空 = ${PM_DATA_DIR}/upload（deploy.sh 会自动补上并写回本文件）
PM_UPLOAD_DIR=./data/upload

# ---------------------------------------------------------------- 应用
# JWT 签名密钥：留空时 deploy.sh 自动生成 64 位随机串并写回本文件。
# 已有部署升级时不要改，否则所有登录 token 会失效。
PM_SECRET_KEY=

# 首次初始化管理员（数据库里已有用户时不会重置密码）
PM_ADMIN_USER=admin
PM_ADMIN_PASSWORD=Admin@123

# 登录有效期（分钟）
PM_ACCESS_TOKEN_EXPIRE_MINUTES=480
# 单个附件大小上限（MB）
PM_UPLOAD_MAX_SIZE_MB=50
# uvicorn 进程数：SQLite 建议保持 1；调大后定时任务靠文件锁去重
PM_WORKERS=1

# ---------------------------------------------------------------- 定时任务 / 备份
PM_SCHEDULER_ENABLED=true
# 每日自动备份数据库到 ${PM_DATA_DIR}/backup
PM_BACKUP_ENABLED=true
PM_BACKUP_KEEP_DAYS=30
PM_DAILY_SCAN_HOUR=1
PM_DIGEST_HOUR=8
PM_DIGEST_MINUTE=30

# 历史数据清理：默认关闭（删除不可逆，确认保留期后再开）
PM_CLEANUP_ENABLED=false

# ---------------------------------------------------------------- 邮件（可选）
PM_SMTP_HOST=
PM_SMTP_PORT=465
PM_SMTP_USER=
PM_SMTP_PASSWORD=
PM_SMTP_USE_SSL=true
PM_MAIL_FROM=

# ---------------------------------------------------------------- 其他
TZ=Asia/Shanghai
