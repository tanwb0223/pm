# 环境变量样例：复制为 .env 后按实际修改
# 注意：.env 不要提交到代码库

# ---------------------------------------------------------------- 数据库
PM_DATABASE_URL=postgresql+psycopg://postgres:123@localhost:5432/pm_dev

# ---------------------------------------------------------------- 应用
PM_APP_NAME=产教融合项目管理系统
PM_DEBUG=false
PM_SECRET_KEY=请替换为随机字符串（至少 32 位）
PM_ACCESS_TOKEN_EXPIRE_MINUTES=30

# ---------------------------------------------------------------- 邮件
PM_SMTP_HOST=smtp.school.edu.cn
PM_SMTP_PORT=465
PM_SMTP_USER=pm@school.edu.cn
PM_SMTP_PASSWORD=
PM_SMTP_USE_SSL=true
PM_MAIL_FROM=产教融合项目管理系统 <pm@school.edu.cn>

# ---------------------------------------------------------------- 短信（可选）
PM_SMS_ENABLED=false
PM_SMS_PROVIDER=
PM_SMS_ACCESS_KEY=
PM_SMS_SECRET_KEY=

# ---------------------------------------------------------------- 附件存储
PM_UPLOAD_DIR=D:/data/pm/upload
PM_UPLOAD_MAX_SIZE_MB=50

# ---------------------------------------------------------------- 定时任务
PM_SCHEDULER_ENABLED=true
PM_DAILY_SCAN_HOUR=1
PM_DIGEST_HOUR=8
PM_DIGEST_MINUTE=30

# ---------------------------------------------------------------- 审计
PM_AUDIT_RETENTION_YEARS=2
PM_SNAPSHOT_RETENTION_YEARS=3

# ---------------------------------------------------------------- 数据保留（年）
PM_AUDIT_RETENTION_YEARS=2
PM_SNAPSHOT_RETENTION_YEARS=3

# ---------------------------------------------------------------- 跨域
# 生产环境填实际访问地址（JSON 数组）；前后端同域时可留空
# PM_CORS_ORIGINS=["https://pm.school.edu.cn"]
