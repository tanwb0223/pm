# 环境变量样例：复制为 .env 后按实际修改
# 注意：.env 不要提交到代码库

# ---------------------------------------------------------------- 数据库
# 数据库连接串
# 留空或不配置 = 使用 SQLite（零依赖，解压即用，默认）
# PM_DATABASE_URL=
#
# 使用 PostgreSQL 时取消注释并修改：
# PM_DATABASE_URL=postgresql+psycopg://用户名:密码@127.0.0.1:5432/pm_prod

# ---------------------------------------------------------------- 应用
PM_APP_NAME=产教融合项目管理系统
PM_DEBUG=false
# 【必填】JWT 签名密钥，至少 32 位随机串。留空或使用占位值，非调试模式下应用会拒绝启动。
# 生成方式：python -c "import secrets; print(secrets.token_urlsafe(48))"
PM_SECRET_KEY=
PM_ACCESS_TOKEN_EXPIRE_MINUTES=480
# 同一账号连续登录失败上限与锁定时长（分钟）
PM_LOGIN_MAX_ATTEMPTS=5
PM_LOGIN_LOCK_MINUTES=15

# ---------------------------------------------------------------- 邮件
PM_SMTP_HOST=smtp.school.edu.cn
PM_SMTP_PORT=465
PM_SMTP_USER=pm@school.edu.cn
PM_SMTP_PASSWORD=
PM_SMTP_USE_SSL=true
PM_MAIL_FROM=产教融合项目管理系统 <pm@school.edu.cn>

# ---------------------------------------------------------------- 短信（可选）
PM_SMS_ENABLED=false
PM_SMS_PROVIDER=
PM_SMS_ACCESS_KEY=
PM_SMS_SECRET_KEY=

# ---------------------------------------------------------------- 附件存储
# 数据根目录（留空则按平台自动选择）
#   Linux:   /data/pm
#   Windows: D:/data/pm（无 D 盘时回退到项目目录下 data/）
# PM_DATA_DIR=

# 附件目录（留空则用 {PM_DATA_DIR}/upload）
# PM_UPLOAD_DIR=
PM_UPLOAD_MAX_SIZE_MB=50

# ---------------------------------------------------------------- 定时任务
PM_SCHEDULER_ENABLED=true
PM_DAILY_SCAN_HOUR=1
PM_DIGEST_HOUR=8
PM_DIGEST_MINUTE=30

# ---------------------------------------------------------------- 审计
PM_AUDIT_RETENTION_YEARS=2
PM_SNAPSHOT_RETENTION_YEARS=3

# ---------------------------------------------------------------- 数据保留（年）
PM_AUDIT_RETENTION_YEARS=2
PM_SNAPSHOT_RETENTION_YEARS=3

# ---------------------------------------------------------------- 跨域
# 生产环境填实际访问地址（JSON 数组）；前后端同域时可留空
# PM_CORS_ORIGINS=["https://pm.school.edu.cn"]

# ---------------------------------------------------------------- 前端托管
# 单机部署时由 FastAPI 直接托管前端（无需 nginx）
PM_FRONTEND_SERVE=true
# PM_FRONTEND_DIR=  留空则自动查找 ../frontend/dist
